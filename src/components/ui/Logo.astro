---
/**
 * The Site Sentinel lockup: the real brand mark plus the wordmark and descriptor.
 *
 * The mark at public/images/logo-mark.svg is the genuine vector artwork, copied
 * from the Site Sentinel SSA app repository (assets/images/logo.svg). It is not
 * a redrawing. Do not replace it with a hand-built approximation: if a different
 * format is needed, take it from the product repositories or from the brand
 * files, never from an AI reconstruction.
 *
 * public/images/logo-lockup.png is the full mark plus wordmark on transparent
 * background, from the Rails application. Use it where a single image is easier
 * than this composed lockup.
 */
import { homepage } from '../../content/homepage.ts';

interface Props {
  /** Render for a dark background. */
  onDark?: boolean;
  /**
   * Colours follow the header's `is-solid` class, so the nav renders one logo
   * rather than mounting two and duplicating the wordmark for screen readers.
   */
  responsiveToHeader?: boolean;
  class?: string;
}

const { onDark = false, responsiveToHeader = false, class: className = 'h-9' } = Astro.props;
const site = homepage.site;

const wordmarkTone = responsiveToHeader
  ? 'text-white [.is-solid_&]:text-navy'
  : onDark
    ? 'text-white'
    : 'text-navy';

const descriptorTone = responsiveToHeader
  ? 'text-ink-on-dark-soft [.is-solid_&]:text-ink-muted'
  : onDark
    ? 'text-ink-on-dark-soft'
    : 'text-ink-muted';
---

<a href="/" class:list={['flex items-center gap-3', className]} aria-label={`${site.name} home`}>
  <img src="/images/logo-mark.svg" alt="" class="h-full w-auto" />

  <span class="flex flex-col leading-none">
    <span class:list={['text-base font-bold tracking-tight uppercase sm:text-lg', wordmarkTone]}>
      {site.name}
    </span>
    <span
      class:list={[
        'mt-0.5 text-[0.5rem] font-semibold tracking-[0.2em] uppercase sm:text-[0.6rem]',
        descriptorTone,
      ]}
    >
      {site.descriptor}
    </span>
  </span>
</a>
