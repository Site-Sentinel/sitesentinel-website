---
/**
 * 11 Industries. Four photographic tiles. Each is already a link so these can
 * become real industry pages later without touching the markup.
 */
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Figure from '../ui/Figure.astro';
import { ArrowRight } from '@lucide/astro';
import { homepage } from '../../content/homepage.ts';

const industries = homepage.industries;
---

<Section id={industries.id} tone="soft">
  <SectionHeading
    eyebrow={industries.eyebrow}
    heading={industries.heading}
    headingAccent={industries.headingAccent}
    size="display-sm"
  />

  <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      industries.items.map((item) => (
        <li>
          <a
            href={item.href}
            class="group focus-visible:outline-cyan relative block h-72 overflow-hidden rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            <Figure
              src={item.image.src}
              alt={item.image.alt}
              class="h-full transition-transform duration-500 group-hover:scale-105"
            />
            <span
              class="from-navy-deep via-navy/40 absolute inset-0 bg-gradient-to-t to-transparent"
              aria-hidden="true"
            />
            <span class="absolute inset-x-0 bottom-0 flex flex-col gap-1.5 p-5">
              <span class="flex items-center gap-2 text-sm font-bold tracking-wide text-white uppercase">
                {item.name}
                <ArrowRight class="text-cyan h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" />
              </span>
              <span class="text-ink-on-dark-soft text-xs leading-relaxed">{item.body}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>
