---
/**
 * 01 Hero. Full-bleed container photography with a navy gradient over the left
 * so the headline stays legible. The brand signature sits bottom right, present
 * but deliberately quieter than the headline.
 */
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Figure from '../ui/Figure.astro';
import DiagonalSlash from '../ui/DiagonalSlash.astro';
import Signature from '../ui/Signature.astro';
import { homepage } from '../../content/homepage.ts';

const hero = homepage.hero;
---

<section id={hero.id} class="bg-navy relative isolate overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <Figure src={hero.image!.src} alt={hero.image!.alt} loading="eager" />
  </div>

  <!-- Legibility scrim. Strong on the left, clearing to the right so the
       container unit in the photograph stays visible. -->
  <div
    class="from-navy-deep via-navy/85 to-navy/30 absolute inset-0 -z-10 bg-gradient-to-r"
    aria-hidden="true"
  >
  </div>
  <div
    class="from-navy-deep/80 to-navy/40 absolute inset-0 -z-10 bg-gradient-to-t via-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 pt-28 pb-16 sm:px-6 sm:pt-36 sm:pb-24 lg:px-8">
    <div class="max-w-2xl">
      <Eyebrow onDark>{hero.eyebrow}</Eyebrow>

      <h1 class="display mt-4 text-white">
        {hero.heading}
        <br />
        <span class="text-cyan">{hero.headingAccent}</span>
      </h1>

      <p class="text-ink-on-dark-soft mt-6 max-w-xl text-base leading-relaxed sm:text-lg">
        {hero.lead}
      </p>

      {hero.body.map((line) => <p class="mt-3 text-base font-semibold text-white">{line}</p>)}

      <div class="mt-8 flex flex-wrap gap-3">
        {
          hero.links.map((link) => (
            <Button href={link.href} variant={link.variant} onDark>
              {link.label}
            </Button>
          ))
        }
      </div>

      <ul
        class="text-ink-on-dark-soft mt-10 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-semibold tracking-widest uppercase sm:gap-x-6"
      >
        {
          hero.sectors.map((sector, i) => (
            <li class="flex items-center gap-4 sm:gap-6">
              {i > 0 && (
                <span class="hidden text-white/25 sm:inline" aria-hidden="true">
                  |
                </span>
              )}
              {sector}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="absolute right-4 bottom-6 hidden sm:right-24 sm:block lg:right-32">
    <Signature>{hero.signature}</Signature>
  </div>

  <DiagonalSlash class="hidden sm:flex" />
</section>
