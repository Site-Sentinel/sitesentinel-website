---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import { homepage } from '../content/homepage.ts';

const content = homepage.notFound;
---

<Layout title={content.title} noindex>
  <section id="hero" class="bg-navy flex min-h-[70vh] items-center">
    <div class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
      <p class="eyebrow text-cyan">{content.eyebrow}</p>
      <h1 class="display mt-4 text-white">{content.heading}</h1>
      <p class="text-ink-on-dark-soft mt-5 text-sm">
        {content.body}
      </p>
      <div class="mt-8 flex justify-center">
        <Button href={content.homeLink.href} variant="primary" onDark
          >{content.homeLink.label}</Button
        >
      </div>
    </div>
  </section>
</Layout>
